# Local settings and secrets for `panzer` (tools/panzer.py) and the publisher.
# Copy to .env next to this file (never committed: .gitignore lists it) and fill
# in what you use. Real environment variables always win over .env.
#
# `panzer secrets` copies the three tokens below into GitHub Actions secrets of
# every repository in mods.toml and panzer-build-logic (or, with --org, into
# organization secrets), so they are set in one place.

# Modrinth personal access token (scopes: create versions, write projects).
# https://modrinth.com/settings/pats
MODRINTH_TOKEN=

# CurseForge upload API token. https://legacy.curseforge.com/account/api-tokens
CURSEFORGE_TOKEN=

# Fine-grained GitHub token for panzer-build-logic's Mods workflow: it pushes
# the shared files to every mod and tags releases. Resource owner PanzerDevOrg,
# repositories: every mod in mods.toml; permissions: Contents (read and write),
# Workflows (read and write). https://github.com/settings/personal-access-tokens
PANZER_SYNC_TOKEN=

# Token for `gh` when publishing GitHub releases locally (`panzer publish`).
# Leave empty to use your `gh auth login` session.
GH_TOKEN=

# Folder holding the mod checkouts (default: the folder holding
# panzer-build-logic), for `panzer sync --all` and `panzer mods`.
PANZER_MODS_DIR=
